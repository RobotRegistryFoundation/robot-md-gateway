# robot-md-gateway udev policy
# Generated by robot-md-gateway init wizard. Do not edit manually.
# GW-001 cert property: direct device-node bypass denial.

# Serial robot devices
SUBSYSTEM=="tty", ATTRS{idVendor}=="@TTY_VENDOR_HEX@", MODE="0660", OWNER="@SERVICE_ACCOUNT@", GROUP="@SERVICE_ACCOUNT@"
KERNEL=="ttyACM[0-9]*", MODE="0660", OWNER="@SERVICE_ACCOUNT@", GROUP="@SERVICE_ACCOUNT@"
KERNEL=="ttyUSB[0-9]*", MODE="0660", OWNER="@SERVICE_ACCOUNT@", GROUP="@SERVICE_ACCOUNT@"

# I2C / GPIO buses (commonly used for additional sensors)
KERNEL=="i2c-[0-9]*", MODE="0660", OWNER="@SERVICE_ACCOUNT@", GROUP="@SERVICE_ACCOUNT@"
KERNEL=="gpiochip[0-9]*", MODE="0660", OWNER="@SERVICE_ACCOUNT@", GROUP="@SERVICE_ACCOUNT@"
